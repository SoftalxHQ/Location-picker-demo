var countries = countries_default;
var countryData = {
  NG: ng_default,
  GH: gh_default,
  US: us_default,
  GB: gb_default,
  KE: ke_default,
  ZA: za_default,
  EG: eg_default,
  ET: et_default,
  TZ: tz_default,
  UG: ug_default,
  RW: rw_default,
  SN: sn_default,
  MA: ma_default
};
function getCountryData(countryCode) {
  return countryData[countryCode.toUpperCase()];
}

// src/index.ts
function normalize(value) {
  return value.trim().toLowerCase();
}
function findByName(items, name) {
  const target = normalize(name);
  return items.find((item) => normalize(item.name) === target);
}
function getCountries() {
  return countries;
}
function getStates(countryCode) {
  return getCountryData(countryCode) ?? [];
}
function getLgas(countryCode, stateName) {
  const states = getCountryData(countryCode);
  if (!states) return [];
  return findByName(states, stateName)?.lgas ?? [];
}
function getTowns(countryCode, stateName, lgaName) {
  const lgas = getLgas(countryCode, stateName);
  if (lgas.length === 0) return [];
  return findByName(lgas, lgaName)?.towns ?? [];
}

exports.getCountries = getCountries;
exports.getLgas = getLgas;
exports.getStates = getStates;
exports.getTowns = getTowns;
